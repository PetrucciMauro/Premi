{
  "name": "premi",
  "version": "1.0.0",
  "description": "Premi - Better than Prezi",
  "author": "LateButSafe",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/PetrucciMauro/Premi.git"
  },
  "keywords": ["LateButSafe", "Presentazioni", "Presentation", "SlideShow"],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "npm ci --prefix client && npm ci --prefix server",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "start:memory": "npm run dev:memory --prefix server",
    "dev:client": "npm start --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:server:memory": "npm run dev:memory --prefix server",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm test --prefix server",
    "test:client": "npm test --prefix client -- --watch=false"
  }
}
